# Copy to .env before deployment. Never commit .env.
# IP of the Synology network interface, NOT 0.0.0.0.
NAS_BIND_IP=192.168.30.150

# Your existing RustDesk HBBS directory (read-only mount).
HBBS_DIR=/volume3/docker/rustdeskhbbs

# Existing non-admin NAS user used by the web panel.
PANEL_UID=1026
PANEL_GID=100
